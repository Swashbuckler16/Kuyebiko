
# Kuyebiko Application Configuration

KUYEBIKO_APP_NAME=Kuyebiko
KUYEBIKO_APP_VERSION=0.1.0
KUYEBIKO_DEBUG=false

# Database
KUYEBIKO_DATABASE_PATH=data/kuyebiko.db

# Monitoring
KUYEBIKO_MONITORING_ENABLED=false
KUYEBIKO_EVENT_QUEUE_SIZE=10000

# Data Retention
KUYEBIKO_RAW_EVENT_RETENTION_DAYS=14
KUYEBIKO_INCIDENT_RETENTION_DAYS=90

# Logging
KUYEBIKO_LOG_LEVEL=INFO
